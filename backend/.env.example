# Copia este archivo a backend/.env y rellena los valores. NUNCA subas backend/.env al repo.

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/codexia_db

# Autenticación
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
PORT=3001
NODE_ENV=development

# URL pública (en producción, el dominio HTTPS real, ej. https://codexialab.com)
PUBLIC_BASE_URL=http://localhost:3001

# Mercado Pago (obtener del panel de MP). El Access Token es SECRETO (solo backend).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Precios de licencias (COP)
PRECIO_PRUEBA_COP=10000
PRECIO_INDIVIDUAL_COP=2000000
PRECIO_ESCUELA_COP=12000000

# Phidias (importación de Klassen). Sin token, la importación se desactiva.
PHIDIAS_BASE_URL=https://ds-barranquilla.phidias.co/rest
PHIDIAS_TOKEN=

# --- SSO Microsoft Entra ID (cuentas institucionales) ---
# Datos del registro de la app en Azure (Azure Portal > App registrations).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Dominios de correo aceptados, separados por coma. Vacio = colegioaleman.edu.co
MS_DOMINIOS_PERMITIDOS=colegioaleman.edu.co
# true: si un correo del dominio no tiene cuenta, se le crea una de estudiante.
# false: solo pueden entrar por SSO quienes ya tienen cuenta en Codexia.
MS_AUTO_CREAR=true

# --- PIN de imagenes (prelectores) ---
# Clave para cifrar la copia recuperable del PIN (AES-256-GCM), minimo 16 chars.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin ella el acceso por dibujos funciona, pero el docente no puede volver a verlos.
PIN_SECRET=

# Clave secreta del webhook de Mercado Pago (panel -> Webhooks). Verifica la firma de cada notificacion.
MP_WEBHOOK_SECRET=
