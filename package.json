{
  "name": "besmart",
  "version": "1.0.0",
  "description": "Plataforma educativa gamificada de programación para niños 6-12 años",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:seed": "psql -U postgres -d besmart_db -f database/schema.sql",
    "db:studio": "npm run prisma:studio --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
